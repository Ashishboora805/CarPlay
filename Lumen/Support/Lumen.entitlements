<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	CarPlay Audio app entitlement. It must be requested from Apple
	(https://developer.apple.com/contact/carplay/) and added to your App ID / provisioning
	profile before device builds will sign. See README > CarPlay.
	-->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
